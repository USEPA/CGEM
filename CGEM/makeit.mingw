for SOURCE_FILE in $MAIN_SRC
do
  echo \
 "$F90 $FFLAGS $IFLAGS -c main_src/$SOURCE_FILE"
  $F90 $FFLAGS $IFLAGS -c main_src/$SOURCE_FILE
  if [ $? != 0 ]; then exit $?; fi
done


for SOURCE_FILE in $MOC_SRC
do
  echo \
 "$F90 $FFLAGS $IFLAGS -c moc_src/$SOURCE_FILE"
  $F90 $FFLAGS $IFLAGS -c moc_src/$SOURCE_FILE
  if [ $? != 0 ]; then exit $?; fi
done


