echo \
"$F90 $FFLAGS $LFLAGS -o CGEM.exe *.o $LIBS"
 $F90 $FFLAGS $LFLAGS -o CGEM.exe *.o $LIBS
if [ $? != 0 ]; then exit $?; fi

rm *.o
rm *.mod
ls -l CGEM.exe
file CGEM.exe
objdump -p CGEM.exe | grep "DLL Name:"
exit 0

