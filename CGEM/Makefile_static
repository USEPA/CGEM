# INC   = -I. -I/usr/local/apps/netcdf-4.6.3/intel-18.0/include/
# LIBS  = -L/usr/local/apps/netcdf-4.6.3/intel-18.0/lib -lnetcdff -lnetcdf
# INC  = -I. -I/usr/local/apps/netcdf-4.9.2/intel-21.4/include/
# LIBS = -L. -L/usr/local/apps/netcdf-4.9.2/intel-21.4/lib -lnetcdff -lnetcdf
