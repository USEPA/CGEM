# DFLAGS = -debug -check all -DDEBUG -warn all -traceback -no-diag-error-limit -ftz

###GNU COMPILER
F90 = gfortran
INC   = -I. -I/usr/local/apps/netcdf-4.8.1/gcc-8.5.0/include -I/home/local-rhel8/apps/hdf5/1.14.6/gcc/8.5/include
#LIBS  = -L. -L/usr/local/apps/netcdf-4.9.3/gcc-12.4/lib  -lnetcdff -lnetcdf
LIBS  = -L. -L/usr/local/apps/netcdf-4.8.1/gcc-8.5.0/lib /usr/local/apps/netcdf-4.8.1/gcc-8.5.0/lib/libnetcdff.a /usr/local/apps/netcdf-4.8.1/gcc-8.5.0/lib/libnetcdf.a -L/home/local-rhel8/apps/hdf5/1.14.6/gcc/8.5/lib /home/local-rhel8/apps/hdf5/1.14.6/gcc/8.5/lib/libhdf5_hl.a /home/local-rhel8/apps/hdf5/1.14.6/gcc/8.5/lib/libhdf5.a -Llib/Linux.x86_64 -lcurl -lz -ldl -lm -lc -lxml2 /home/local-rhel8/apps/gcc/12.4.0/lib/gcc/x86_64-pc-linux-gnu/12.4.0/libgcc.a
#FFLAGS = -Wall -fcheck=all -pedantic -fimplicit-none -fbacktrace -ffree-line-length-none
FFLAGS = -Wall -fcheck=all -pedantic -fimplicit-none -fbacktrace -ffree-line-length-none
# DFLAGS = -g -O0 -fbacktrace -ffpe-trap=zero,invalid,overflow,underflow -fbounds-check -fcheck=all -ffree-line-length-none

### =============== End User Modifiable Section  =============== ####
include main_src/src_files_serial
include moc_src/src_files
include cgem_src/src_files
include wqem_src/src_files

maindir=main_src
mocdir=moc_src
cgemdir=cgem_src
wqemdir=wqem_src

CGEM: ${PAR_OBJ} ${SER_OBJ} ${MAIN_OBJ} ${MOC_OBJ} ${CGEM_OBJ} ${WQEM_OBJ}
	$(F90) -o $(EXE) $(FFLAGS) $(DFLAGS) $(INC) $(PAR_OBJ) $(SER_OBJ) $(MAIN_OBJ) ${MOC_OBJ} ${CGEM_OBJ} ${WQEM_OBJ} $(LIBS)


#
# Pattern rules
#

# These items must have compiler optimization disabled
$(NO_OPT_OBJS): %.o: %.F90
	$(F90) -c -O0 $(FFLAGS) $(DFLAGS) $<

$(MAIN_OBJ):%.o: $(maindir)/%.F90
	$(F90) $(INC) -c $(FFLAGS) $(DFLAGS)  $<

$(MOC_OBJ):%.o: $(mocdir)/%.F90
	$(F90) -c $(FFLAGS) $(DFLAGS)  $<

$(OBJ):%.o: %.F90
	$(F90) -c $(FFLAGS) $(DFLAGS) $<

$(CGEM_OBJ):%.o: $(cgemdir)/%.F90
	$(F90) $(INC) -c $(FFLAGS) $(DFLAGS)   $<

$(WQEM_OBJ):%.o: $(wqemdir)/%.F90
	$(F90) $(INC) -c $(FFLAGS) $(DFLAGS)  $<

$(PAR_OBJ):%.o: $(maindir)/%.F90
	$(F90) $(INC) -c  $<

$(SER_OBJ):%.o: $(maindir)/%.F90
	$(F90) $(INC) -c  $<

#
# Miscellaneous targets
#

clean:
	rm -f *.o ${EXE} *.mod *genmod*

tags:
	ctags --language-force=Fortran *.F90

etags:
	etags -l fortran *.F90
